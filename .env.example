# =============================================================
# Telegram Shop Bot — Environment Variables
# =============================================================
# Recommended: let the built-in initializer create a private .env:
#   telegram-shop-bot init
# Manual alternative: copy this file to .env and fill in your values.
#
# Then start the bot:
#   make quickstart          # guided setup + checks + local run
#   make docker-up           # Docker
# =============================================================

# ---------------------------
# Required
# ---------------------------

# Telegram Bot token — get it from @BotFather
BOT_TOKEN=

# Telegram username of the bot (without @), used for referral deep-links
BOT_USERNAME=

# Comma-separated Telegram user IDs with admin access
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# ---------------------------
# Admin notifications (optional)
# ---------------------------

# Supergroup chat ID for admin order notifications (usually negative, e.g. -1001234567890).
# When set, order notifications go to this group instead of DMs to ADMIN_IDS.
ADMIN_GROUP_ID=

# Forum topic IDs (message_thread_id) inside ADMIN_GROUP_ID for routing by event.
# Leave empty to post to the group's General topic.
TOPIC_ORDERS_NEW=
TOPIC_ORDERS_PAID=
TOPIC_ORDERS_DELIVERED=

# ---------------------------
# Database
# ---------------------------

# Path to the SQLite database file (created automatically on first run)
DB_PATH=data/shop.db

# ---------------------------
# Redis (FSM state and caching)
# ---------------------------

REDIS_ADDR=localhost:6379
# Leave empty if Redis has no auth
REDIS_PASSWORD=

# ---------------------------
# Payments
# ---------------------------

# Telegram Stars per 1 USD (Telegram sells 50 Stars for ~$0.99)
USD_TO_STARS_RATE=50

# CryptoBot token for USDT/TON payments — get from @CryptoBot → My Apps
# Leave empty to disable crypto payments
CRYPTOBOT_TOKEN=

# --- YooKassa (RUB card payments, optional) ---
# All three must be set together; leave all empty to disable RUB payments.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Public HTTPS page the buyer returns to after paying.
YOOKASSA_RETURN_URL=
# RUB per 1 USD, e.g. 92.5. Required (and > 0) to enable the RUB pay button.
USD_TO_RUB_RATE=

# --- Stripe (USD card payments, optional) ---
# All three must be set together; leave all empty to disable Stripe payments.
# Must start with sk_live_ or sk_test_.
STRIPE_SECRET_KEY=
# Signing secret for the <WEBHOOK_URL>/stripe-webhook endpoint
# (Stripe Dashboard → Developers → Webhooks). Must start with whsec_.
STRIPE_WEBHOOK_SECRET=
# Public HTTPS page the buyer returns to after paying.
# Example: https://mybot.example.com/stripe-return
STRIPE_RETURN_URL=

# --- TON on-chain payments (optional, polled via toncenter — no webhook) ---
# Wallet address and rate must be set together; leave all empty to disable
# TON payments.
# 48-character base64url friendly address of the shop's TON wallet.
TON_WALLET_ADDRESS=
# USD per 1 TON, e.g. 5.25. Required (and > 0) when TON_WALLET_ADDRESS is set.
USD_PER_TON=
# Optional toncenter API key (raises rate limits); may stay empty.
TON_API_KEY=

# --- NOWPayments crypto payments (optional) ---
# All three must be set together; leave all empty to disable NOWPayments.
NOWPAYMENTS_API_KEY=
# IPN secret for the <WEBHOOK_URL>/nowpayments-webhook endpoint
# (NOWPayments dashboard → Settings → IPN callbacks).
NOWPAYMENTS_IPN_SECRET=
# Public HTTPS page the buyer returns to after paying.
NOWPAYMENTS_RETURN_URL=

# ---------------------------
# Webhook (leave empty to use long polling — recommended for development)
# ---------------------------

# Public HTTPS base URL; Telegram will POST to <base>/telegram-webhook
# Example: https://mybot.example.com
WEBHOOK_URL=

# Required whenever WEBHOOK_URL is set (32-256 Bot API-safe characters)
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------
# Mini App (optional)
# ---------------------------

# Public HTTPS URL of the Mini App. When set, the bot serves the embedded
# web shop at /app/ and the REST API at /api/* on port 8080, and turns the
# bot's menu button into a web_app button. Telegram requires HTTPS.
# Leave empty to disable the Mini App entirely.
# Example: https://mybot.example.com/app
WEBAPP_URL=

# ---------------------------
# Outbound Webhooks (optional)
# ---------------------------

# HTTP POST notifications on order events (order.paid, order.delivered)
# Payload: {"event":"order.paid","order_id":1,"user_id":123,"total_usd":9.99,"method":"stars"}
OUTBOUND_WEBHOOK_URL=

# Sent as X-Webhook-Secret header for receiver verification
OUTBOUND_WEBHOOK_SECRET=

# ---------------------------
# Application
# ---------------------------

# Environment: development | production
# In production, webhook secret is enforced and logs are JSON-formatted
APP_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Path to the directory with locale files (ru.json, en.json, ...)
LOCALES_DIR=locales
